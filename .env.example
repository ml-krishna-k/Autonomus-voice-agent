# Copy to .env and fill in. NEVER commit the real .env.

# ---- Required ---------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ---- LLM --------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenRouter, vLLM, Ollama, Together.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=allenai/olmo-3.1-32b-instruct
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.6
LLM_TIMEOUT_S=60

# Conversation turns kept in context. The main lever on cost — every turn
# re-sends the whole window, so 8 turns costs ~8x a single turn at steady state.
HISTORY_MAX_TURNS=8

# ---- ASR (faster-whisper) ---------------------------------------------------
ASR_MODEL=distil-small.en
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CPU_THREADS=4
ASR_BEAM_SIZE=1
ASR_MAX_CONCURRENCY=2

# ---- TTS (Piper) ------------------------------------------------------------
# Must exist in MODELS_DIR as <voice>.onnx and <voice>.onnx.json.
TTS_VOICE=en_US-amy-low
TTS_MAX_CONCURRENCY=2

# ---- Endpointing ------------------------------------------------------------
INPUT_SAMPLE_RATE=16000
VAD_THRESHOLD=0.01
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=400
VAD_MAX_UTTERANCE_MS=20000
VAD_PREROLL_MS=300
ALLOW_BARGE_IN=true

# ---- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
SERVE_TEST_CLIENT=true
SESSION_TTL_S=1800
MAX_SESSIONS=200
